<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/wizard_title_interests" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingBottom="16dp" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/interestsGroup"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        app:singleLine="false" app:singleSelection="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/nextButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next" />
</LinearLayout>
